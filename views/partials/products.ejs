<% if (products.length > 0) { %>
    <% products.forEach(product => { %>
        <div class="col-md-4">
            <div class="card" style="width: 18rem">
                <img src="/images/<%= product.imageUrl %>" class="card-img-top" alt="<%= product.description %>" />
                <div class="card-body">
                    <h5 class="card-title">
                        <a href="/details/<%= product._id %>">
                            <%= product.name %>
                        </a>
                    </h5>
                    <p class="card-text">
                        <%= product.price %>
                    </p>
                    <form action="/cart/<%= product._id %>" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn btn-primary">Add to Cart</button>
                    </form>
                    
                    <a href="/details/<%= product._id %>" class="btn btn-primary">Details</a>
                </div>
            </div>
        </div>
    <% }) %>
    <% } else { %>
        <h1>No Product</h1>
<% } %>