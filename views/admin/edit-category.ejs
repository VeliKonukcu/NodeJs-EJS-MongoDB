<div class="container">
  <form action="/admin/edit-category/<%= category._id %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="mb-3">
      <label for="id" class="form-label">Category Id</label>
      <input
        type="text"
        class="form-control"
        id="id"
        name="id"
        value="<%= category._id %>"
        readonly
      />
    </div>
    <div class="mb-3">
      <label for="exampleInputEmail1" class="form-label">Category Name</label>
      <input
        type="text"
        class="form-control"
        id="name"
        name="name"
        value="<%= category.name %>"
      />
    </div>
    <div class="mb-3">
      <label for="description" class="form-label">Description</label>
      <input
        type="text"
        class="form-control"
        id="description"
        name="description"
        value="<%= category.description %>"
      />
    </div>

    <button type="submit" class="btn btn-primary">Güncelle</button>
  </form>
</div>
