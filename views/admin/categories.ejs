<div class="container mt-3">
  <div class="row">
    <div>
      <% if (action !== "undefined" && action === "edit") { %>
        <div class="alert alert-success"> Category updated</div>
      <% } %>

      <% if (action !== "undefined" && action === "delete") { %>
        <div class="alert alert-danger"> Category deleted</div>
      <% } %>
      <div class="row">
        <% if (categories.length > 0) { %>
          <table class="table table-bordered">
            <thead>
              <tr>
                <th>Category Name</th>
                <th>Description</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% categories.forEach(category => { %>
                <tr>
                  <td>
                    <h5><%= category.name %></h5>
                  </td>
                  <td>
                    <%= category.description %>
                  </td>
                  <td class="d-flex gap-2">
                    <a href="/admin/edit-category/<%= category._id %>" class="btn btn-primary">Edit</a>
                    <form action="/admin/delete-category/<%= category._id %>" method="post">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <% } else { %>
            <h1>No Category</h1>
        <% } %>
      </div>
    </div>
  </div>
</div>